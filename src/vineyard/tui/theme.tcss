Screen {
    background: $surface;
}

Header {
    background: $primary;
    color: $text;
}

Footer {
    background: $primary 50%;
}

#run-table {
    height: 1fr;
    border: round $accent;
    margin: 1 2;
}

#phases {
    height: 1fr;
    min-height: 6;
    margin: 0;
    padding: 0;
}

.phase-card {
    border: round $accent;
    height: 3;
    padding: 0 2;
    margin: 0 2;
    background: $boost;
}

.phase-card.running {
    border: round $warning;
}

.phase-card.completed {
    border: round $success;
}

.phase-card.failed {
    border: round $error;
}

.phase-card.awaiting {
    border: round $warning;
    background: $warning 20%;
}

.phase-card.clarifying {
    border: round $accent;
    background: $accent 15%;
}

.section-title {
    color: $accent;
    text-style: bold;
    margin: 1 2 0 2;
}

.muted {
    color: $text-muted;
}

#new-run-form > * {
    margin: 0 2;
}

TextArea {
    height: 12;
}

Input {
    margin-bottom: 1;
}

#event-log {
    height: 1fr;
    min-height: 6;
    max-height: 16;
    border: round $accent;
    margin: 1 2;
    background: $boost;
}

#footer-status {
    height: 1;
    margin: 0 2;
}

#confirm-dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    border: round $error;
    background: $surface;
    align: center middle;
}

ConfirmScreen {
    align: center middle;
}

#phase-md {
    margin: 1 2;
}

#build-summary {
    margin: 1 2;
    height: auto;
    max-height: 12;
}

#build-layout {
    height: 1fr;
    margin: 1 2;
}

#build-tree {
    width: 35%;
    border: round $accent;
}

#build-pane {
    width: 1fr;
    border: round $accent;
    padding: 0 1;
}

#build-file-path {
    margin-bottom: 1;
    color: $accent;
}

#phase-scroll {
    height: 1fr;
    margin: 0 2;
}

#phase-md {
    margin: 1 0;
    height: auto;
}

#clarifications {
    margin: 1 0;
    padding: 1 2;
    border: round $accent;
    background: $boost;
    height: auto;
}

.clarification-question {
    color: $accent;
    text-style: bold;
    margin-top: 1;
}
