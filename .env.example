# Vineyard configuration
# Copy to .env (or ~/.vineyard/config.env) and fill in your keys.

# Pydantic AI Gateway (Logfire) — required. Sign up at https://logfire.pydantic.dev.
VINEYARD_PYDANTIC_AI_GATEWAY_API_KEY=pylf_v1_...

# Logfire token — sets up tracing/observability (write token).
VINEYARD_LOGFIRE_TOKEN=

# Logfire read token — used by `vineyard cost <run-id>` to fetch authoritative
# gateway cost from Logfire. Create separately under Project → Read tokens.
VINEYARD_LOGFIRE_READ_TOKEN=

# Anthropic API key — required when using the Managed Agents (beta) executor.
# Forwarded to claude-agent-sdk as ANTHROPIC_API_KEY.
VINEYARD_ANTHROPIC_API_KEY=sk-ant-...

# Defaults (optional)
VINEYARD_DEFAULT_STACK=nextjs
VINEYARD_BUILD_EXECUTOR=pydantic_ai

# Validate phase backend: auto (E2B if key set, else docker, else skip),
# docker (force docker), e2b (force E2B), or none (skip entirely).
VINEYARD_VALIDATE_EXECUTOR=auto

# E2B API key — when set, the VALIDATE phase uses E2B sandboxes instead of
# local docker. Optional; install with `uv sync --extra e2b` to use.
VINEYARD_E2B_API_KEY=

# Where Vineyard keeps its SQLite db and run output dirs.
# VINEYARD_DATA_DIR=~/.vineyard
